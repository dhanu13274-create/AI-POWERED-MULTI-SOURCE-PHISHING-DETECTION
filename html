<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhishGuard | Phishing Detection</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;font-family:Arial,sans-serif;
 background:#0b1020;color:#f1f5ff;
 padding:24px
}
main{max-width:850px;margin:30px auto}
header{color:#5eead4;font-size:20px;font-weight:bold}
h1{font-size:38px;margin-bottom:10px}
p{color:#b9c5dc;line-height:1.6}
.card{
 background:#141d33;border:1px solid #2d3b59;
 padding:24px;border-radius:15px;margin-top:22px
}
input{
 width:100%;padding:15px;margin-top:10px;
 background:#0b1326;color:white;
 border:1px solid #52617e;border-radius:8px;font-size:16px
}
button{
 width:100%;padding:14px;margin-top:14px;
 background:#5eead4;color:#06251f;border:0;
 border-radius:8px;font-size:16px;font-weight:bold;cursor:pointer
}
button:hover{background:#99f6e4}
.result{display:none}
.score{font-size:30px;font-weight:bold;color:#5eead4}
.bad{color:#fca5a5}
.good{color:#86efac}
li{margin:12px 0;line-height:1.5}
footer{font-size:12px;margin-top:25px;color:#9ba9c5}
</style>
</head>

<body>
<main>
<header>🛡 PHISHGUARD</header>

<h1>Check before you click.</h1>
<p>Phishing Detection and Prevention Platform</p>
<p>Analyze suspicious website URLs and identify potential warning signs.</p>

<section class="card">
<h2>Website Security Scanner</h2>
<label for="url">Enter website URL</label>
<input id="url" type="text"
placeholder="https://example.com/login">
<button onclick="scanURL()">Analyze URL</button>
<p id="error" class="bad"></p>
</section>

<section class="card result" id="result" aria-live="polite">
<h2>Scan Results</h2>
<div class="score" id="score"></div>
<h3 id="status"></h3>
<p id="summary"></p>
<h3>Detected Warning Signs</h3>
<ul id="warnings"></ul>
<p><b>Analysis type:</b> Local rule-based URL analysis</p>
</section>

<section class="card">
<h3>How PhishGuard Works</h3>
<ul>
<li>Checks URL structure and suspicious symbols.</li>
<li>Looks for suspicious words and unusual domains.</li>
<li>Checks whether HTTPS is used.</li>
<li>Displays a risk score and warning signs.</li>
</ul>
</section>

<footer>
Educational prototype only. This version does not use a trained
machine-learning model or live threat-intelligence databases.
A low risk score does not guarantee a website is safe.
</footer>
</main>

<script>
function scanURL(){
 const input=document.getElementById("url").value.trim();
 const error=document.getElementById("error");
 const result=document.getElementById("result");
 const warnings=document.getElementById("warnings");

 error.textContent="";
 result.style.display="none";

 if(!input){
  error.textContent="Please enter a website URL.";
  return;
 }

 let address=input;
 if(!/^https?:\/\//i.test(address)){
  address="https://"+address;
 }

 let parsed;
 try{
  parsed=new URL(address);
 }catch(e){
  error.textContent="Please enter a valid URL.";
  return;
 }

 if(!["http:","https:"].includes(parsed.protocol) ||
    !parsed.hostname.includes(".") ||
    /\s/.test(parsed.hostname) ||
    parsed.hostname.startsWith(".") ||
    parsed.hostname.endsWith(".")){
  error.textContent="Please enter a valid website domain.";
  return;
 }

 const host=parsed.hostname.toLowerCase();
 const full=address.toLowerCase();
 let risk=0;
 let findings=[];

 if(parsed.username || parsed.password){
  risk+=25;
  findings.push("The URL contains embedded login credentials.");
 }

 if(input.length>100){
  risk+=10;
  findings.push("The URL is unusually long.");
 }

 if((host.match(/-/g)||[]).length>=3){
  risk+=10;
  findings.push("The domain contains several hyphens.");
 }

 if(/^\d{1,3}(\.\d{1,3}){3}$/.test(host)){
  risk+=25;
  findings.push("The hostname appears to be an IP address.");
 }

 if(host.split(".").length>=5){
  risk+=10;
  findings.push("The hostname has many subdomains.");
 }

 const shorteners=[
  "bit.ly","tinyurl.com","t.co","cutt.ly","is.gd","rb.gy"
 ];
 if(shorteners.includes(host)){
  risk+=15;
  findings.push("The URL uses a shortening service.");
 }

 const suspicious=[
  "verify","password","account","urgent","prize",
  "signin","wallet","recover","banking","confirm"
 ];

 const matches=suspicious.filter(word=>full.includes(word));
 if(matches.length){
  risk+=Math.min(matches.length*7,25);
  findings.push("Suspicious keywords: "+matches.join(", ")+".");
 }

 if(parsed.protocol!=="https:"){
  risk+=10;
  findings.push("HTTPS is not used. This alone does not prove phishing.");
 }

 risk=Math.min(risk,100);

 if(findings.length===0){
  findings.push("No warning signs were detected by these basic checks.");
 }

 document.getElementById("score").textContent=risk+"/100";
 document.getElementById("status").textContent=
  risk>=50?"HIGH RISK — Use caution":
  risk>=25?"POTENTIAL RISK — Review carefully":
  "LOWER RISK — Basic checks only";

 document.getElementById("summary").textContent=
  risk>=50?"Several warning signs were detected. Verify the website independently.":
  risk>=25?"Some warning signs were found. Check the domain carefully.":
  "Few warning signs were found. This does not prove the website is safe.";

 document.getElementById("score").className=
  "score "+(risk>=50?"bad":risk<25?"good":"");

 warnings.replaceChildren();
 findings.forEach(item=>{
  const li=document.createElement("li");
  li.textContent=item;
  warnings.appendChild(li);
 });

 result.style.display="block";
 result.scrollIntoView({behavior:"smooth",block:"start"});
}
</script>
</body>
</html>
